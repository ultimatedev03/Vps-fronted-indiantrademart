# Frontend (Vite) environment
# Copy to .env.local and fill real values. Only VITE_* keys are exposed to the browser.

# Public API base for browser calls (empty in dev to use Vite proxy /api)
# Keep this empty on VPS when Nginx proxies `/api` to the backend on the same domain.
VITE_API_URL=https://api.indiantrademart.com

# Supabase (browser anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Site metadata used by prerender and sitemaps
VITE_SITE_URL=https://your-domain.com
